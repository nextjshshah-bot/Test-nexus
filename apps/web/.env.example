# ---------------------------------------------------------------------------
# NexusCore Web — environment template
# ---------------------------------------------------------------------------

# Browser-facing API base. Keep this relative so the Next.js rewrite proxies
# requests to the backend (first-party cookies, no CORS).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side proxy target used by next.config.mjs rewrites.
API_PROXY_TARGET=http://127.0.0.1:4000

# Branding
NEXT_PUBLIC_APP_NAME=NexusCore

# Authentication mode: "live" hits the API, "demo" uses the local sample data.
NEXT_PUBLIC_AUTH_MODE=live

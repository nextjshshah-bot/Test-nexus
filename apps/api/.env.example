# ---------------------------------------------------------------------------
# NexusCore API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL). Railway injects DATABASE_URL automatically.
DATABASE_URL=postgresql://nexus:nexus_dev_password@127.0.0.1:5432/nexuscore?schema=public

# JWT — use at least 32 random characters each in production:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me_at_least_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=nexuscore-api
JWT_AUDIENCE=nexuscore-web

# CORS — comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Cookies — leave COOKIE_DOMAIN empty for localhost
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=25

# Ops
LOG_LEVEL=debug
RUN_MIGRATIONS_ON_BOOT=false
TRUST_PROXY=false
